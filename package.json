{
  "name": "dsh-mcp-oauth-client",
  "version": "0.3.0",
  "description": "DeepSeek Harness 的通用 MCP 管理器与客户端桥接插件",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh.md", "CHANGELOG.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepare": "node --check lib/index.js && node --check lib/client.js",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "mcp", "oauth", "stdio"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/fangzaozao/dsh-mcp-oauth-client.git" },
  "bugs": { "url": "https://github.com/fangzaozao/dsh-mcp-oauth-client/issues" },
  "homepage": "https://github.com/fangzaozao/dsh-mcp-oauth-client#readme"
}
